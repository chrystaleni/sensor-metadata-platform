# Development-only examples. Do not use these values outside local development.
POSTGRES_DB=sensor_metadata_dev
POSTGRES_USER=sensor_dev
POSTGRES_PASSWORD=local-development-only-change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# PostgreSQL/PostGIS is the standard local database. Use sqlite explicitly only
# for isolated development tasks that do not require PostGIS integration.
DJANGO_DATABASE_ENGINE=postgis

# Development-only defaults. Replace the secret for any shared environment.
DJANGO_SECRET_KEY=django-insecure-local-development-only-change-me
DJANGO_DEBUG=True

# Metadata integration configuration (PR #31 explicit-Platform behavior).
# Add the approved existing integer Platform Department ID before using catalogs.
# Leaving this unset in PR #31 disables Platform selection; it never defaults to 1.
# METADATA_PLATFORM_DEPARTMENT_ID=<approved-existing-department-id>
#
# Defaults below keep the local model boundary and deny metadata access.
# Replace these only with the team's agreed installed model and access adapter.
# Changing the Department model after migrations requires a migration plan.
# METADATA_DEPARTMENT_MODEL=local_departments.Department
# METADATA_ACCESS_POLICY=metadata.access.NoAccessPolicy

# On installations with Organisation support, use provision_platform_department
# to create or verify the owner, then set the ID printed by the command.
# For existing data, complete the approved Organisation backfill first.
