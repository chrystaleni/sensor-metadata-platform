# Development-only examples. Do not use these values outside local development.
POSTGRES_DB=sensor_metadata_dev
POSTGRES_USER=sensor_dev
POSTGRES_PASSWORD=local-development-only-change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Leave on sqlite for local development and tests without Docker.
# Set to postgis to use the local Docker Compose database.
DJANGO_DATABASE_ENGINE=sqlite

# Development-only defaults. Replace the secret for any shared environment.
DJANGO_SECRET_KEY=django-insecure-local-development-only-change-me
DJANGO_DEBUG=True
